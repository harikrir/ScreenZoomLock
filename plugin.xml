<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-plugin-display-lock"
        version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>DisplayLock</name>
    <description>Plugin to safely enforce standard font scale and lock zoom/display settings in OutSystems Cordova apps.</description>
    <license>MIT</license>

    <!-- ================= JS ================= -->
    <js-module src="www/DisplayLock.js" name="DisplayLock">
        <clobbers target="cordova.plugins.DisplayLock" />
    </js-module>

    <!-- ================= ANDROID ================= -->
    <platform name="android">

        <source-file src="src/android/DisplayLockPlugin.java"
                     target-dir="app/src/main/java/com/outsystems/plugin/displaylock" />

        <config-file target="config.xml" parent="/*">
            <feature name="DisplayLock">
                <param name="android-package" 
                       value="com.outsystems.plugin.displaylock.DisplayLockPlugin" />
            </feature>
        </config-file>

    </platform>

</plugin>
